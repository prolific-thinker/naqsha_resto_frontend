# Copy to `.env.local` and fill in. Vite only exposes vars prefixed with VITE_.

# Backend API base URL (no trailing slash). Prepended to every path in
# src/lib/api/endpoints.ts. Leave empty if you proxy /api through Vite
# (see docs/INTEGRATION.md §5).
VITE_API_BASE=http://localhost:8000

# Data source switch:
#   true  (default) → in-memory mocks from src/lib/mocks/* (no backend needed)
#   false           → real HTTP calls to VITE_API_BASE
VITE_USE_MOCKS=true

# ── Cameras (see docs/CAMERA_HIKVISION_SETUP.md) ──────────────────────────────
# How your media gateway (MediaMTX / go2rtc) publishes the streams:
#   hls | webrtc | mjpeg
VITE_CAM_KIND=hls
# One browser-playable URL per camera (gateway URLs, NOT rtsp://…@camera).
# Empty = the tile shows an honest "Stream not configured" state.
VITE_CAM1_URL=
VITE_CAM2_URL=
VITE_CAM3_URL=
VITE_CAM4_URL=
