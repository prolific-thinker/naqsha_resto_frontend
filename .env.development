# Development env. Vite loads this automatically for `pnpm dev`.
# Do not add a .env.local that overrides VITE_API_BASE — see below.

# EMPTY, always. The SPA and Frappe share one origin behind nginx (D-06), so every
# path in src/lib/api/endpoints.ts is relative. Setting this to an absolute URL
# re-introduces cross-origin requests, and the failure is subtle: reads keep working
# while every mutation dies on CSRF, and the realtime socket stops authenticating
# because Frappe compares the Host and Origin hostnames.
VITE_API_BASE=

# Real backend. Mocks are only still used by the not-yet-wired ERP screens.
VITE_USE_MOCKS=false

# The Frappe site name. Used for the socket.io namespace, which Frappe requires to
# equal the site name — it is NOT safe to derive this from window.location.hostname,
# because nginx may serve the SPA on a hostname that differs from the site name.
VITE_SITE_NAME=naqsha_ops.localhost

# ── Cameras (v2) ─────────────────────────────────────────────────────────────
VITE_CAM_KIND=hls
VITE_CAM1_URL=
VITE_CAM2_URL=
VITE_CAM3_URL=
VITE_CAM4_URL=
